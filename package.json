{
  "name": "cortex-bci-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "High-performance Brain-Computer Interface engine and real-time telemetry runtime",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build crates/neuro-dsp --target web --out-dir ../../packages/core/src/wasm",
    "build": "npm run build --workspace=apps/web",
    "dev": "npm run dev --workspace=apps/web",
    "test:rust": "cargo test --manifest-path crates/neuro-dsp/Cargo.toml",
    "test": "npm run test:rust"
  },
  "keywords": [
    "bci",
    "eeg",
    "brain-computer-interface",
    "rust",
    "webassembly",
    "dsp",
    "neuroscience"
  ],
  "author": "Gabriel Rondon",
  "license": "Apache-2.0"
}
